{
  "expo": {
    "name": "Frendzy",
    "slug": "seshhon",
    "scheme": "seshhon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050506",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050506"
    },
    "ios": {
      "bundleIdentifier": "com.seshhon.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Frendzy uses your location to show venues near you and how far away they are.",
        "NSCameraUsageDescription": "Frendzy uses your camera for the 18+ age check selfie. The photo goes to our age check provider and is not kept by Frendzy."
      }
    },
    "android": {
      "package": "com.seshhon.app",
      "adaptiveIcon": {
        "backgroundColor": "#050506",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "seshhon"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "webUrl": "https://frendzy.au/"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Frendzy uses your photos so you can pick a profile photo. Only your friends see it.",
          "cameraPermission": "Frendzy uses your camera for the 18+ age check selfie. The photo goes to our age check provider and is not kept by Frendzy.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
